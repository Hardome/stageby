{
  "name": "stageby",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.7.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "dev": "pnpm --dir web exec concurrently --raw -k \"pnpm --dir ../api run dev\" \"pnpm run dev\"",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres"
  }
}
