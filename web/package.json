{
  "name": "@stageby/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run codegen && tsc -b && vite build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "preview": "vite preview",
    "codegen": "concurrently -n api,routes \"pnpm run codegen:api\" \"pnpm run codegen:routes\"",
    "codegen:api": "kubb generate",
    "codegen:routes": "tsr generate",
    "format": "biome format --write --no-errors-on-unmatched .",
    "lint": "concurrently -n biome,eslint,styles,fsd,spell \"pnpm run lint:biome\" \"pnpm run lint:eslint\" \"pnpm run lint:styles\" \"pnpm run lint:fsd\" \"pnpm run lint:spell\"",
    "lint:biome": "biome check --write --unsafe --no-errors-on-unmatched .",
    "lint:eslint": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache --concurrency auto --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\" --fix --allow-empty-input",
    "lint:fsd": "steiger ./src",
    "lint:spell": "cspell --config ../cspell.config.yaml \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,js,json}\"",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "heic-to": "1.6.6",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.4",
    "react-hook-form": "7.90.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cspell/dict-ru_ru": "2.3.4",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@kubb/plugin-fetch": "5.7.0",
    "@kubb/plugin-react-query": "5.5.4",
    "@kubb/plugin-ts": "5.0.14",
    "@kubb/plugin-zod": "5.4.12",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "1.167.45",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.6",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "kubb": "5.12.1",
    "shadcn": "4.22.1",
    "steiger": "0.8.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
