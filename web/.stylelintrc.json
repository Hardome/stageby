{
  "extends": ["stylelint-config-recommended"],
  "ignoreFiles": ["dist/**", "node_modules/**", "src/generated/**"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["apply", "custom-variant", "plugin", "source", "theme", "utility", "variant"]
      }
    ],
    "no-descending-specificity": null,
    "function-no-unknown": [
      true,
      {
        "ignoreFunctions": ["theme"]
      }
    ]
  }
}
