{
  "name": "@stageby/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm run codegen && tsc -p tsconfig.build.json",
    "codegen": "openapi-ts && pnpm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "format": "biome format --write src openapi-ts.config.ts drizzle.config.ts vitest.config.ts",
    "lint": "pnpm run lint:biome:fix && pnpm run spellcheck && pnpm run typecheck",
    "lint:biome:fix": "biome check --write --unsafe --no-errors-on-unmatched",
    "start": "node dist/server.js",
    "spellcheck": "cspell --config ../cspell.config.yaml \"src/**/*.ts\" \"test/**/*.ts\" \"../docs/**/*.md\" \"*.config.ts\" README.md .env.example",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cspell/dict-ru_ru": "2.3.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "cspell": "10.3.3",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
