{
  "name": "@stageby/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "engines": {
    "node": ">=24.7.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "admin:create-first-manager": "node --conditions=development src/commands/create-first-manager.ts",
    "build": "pnpm run codegen && tsc -p tsconfig.build.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "codegen": "openapi-ts && pnpm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "lint": "pnpm run lint:biome:fix && pnpm run spellcheck && pnpm run typecheck",
    "lint:biome:fix": "biome check --write --unsafe --no-errors-on-unmatched",
    "lint:knip": "knip --tsConfig tsconfig.build.json",
    "start": "node dist/server.js",
    "spellcheck": "cspell --config ../cspell.config.yaml \"src/**/*.ts\" \"test/**/*.ts\" \"../docs/**/*.md\" \"*.config.ts\" README.md .env.example",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cspell/dict-ru_ru": "2.3.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "cspell": "10.4.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
